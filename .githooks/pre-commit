#!/bin/sh
# Blocks a commit that stages a credential-looking literal. Enable once per clone:
#   npm run hooks:install      (= git config core.hooksPath .githooks)
# Bypass for a genuine fixture: add it to scripts/secret-scan.allow.json instead of using --no-verify.
exec node "$(git rev-parse --show-toplevel)/scripts/secret-scan.mjs" --staged
