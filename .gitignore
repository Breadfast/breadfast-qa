# deps / build
node_modules/
dist/
.next/
*.tsbuildinfo
coverage/

# per-machine env (ship .env.example instead)
.env
.env.local

# per-person credentials — ship credentials.local.example.js, never the real one.
# NOTE: this rule does NOT untrack a file already committed; see automation/config/README.md.
automation/config/credentials.local.js
**/credentials.local.js

# personal / runtime (belt-and-suspenders — these live in the workspace, not the repo)
runtime/
**/*.db
**/*.db-journal
*.log
logs/
auth/figma-auth.json
browser-sessions/

# generated media / artifacts
*.zip
*.mp4
test-results/
playwright-report/
.playwright-mcp/
.history/

# editor + root-level story evidence (screenshots / generated PDFs — not part of the platform)
.vscode/
/*.png
/*.pdf

# Per-story folders at the repo root (B10-<key>/): version-control the automation
# test scripts + README only; ignore the heavy per-run artifacts (figma frames,
# screenshots, evidence, analysis exports, CSVs, reports) so the repo stays lean.
/B10-*/*
!/B10-*/automation/
!/B10-*/README.md
/B10-*/automation/**/*.png
/B10-*/automation/**/*.zip
