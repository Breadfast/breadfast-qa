{
  "extraKnownMarketplaces": {
    "breadfast": {
      "source": { "source": "github", "repo": "Breadfast/breadfast-workflow" }
    },
    "humanizer": {
      "source": { "source": "git", "url": "https://github.com/blader/humanizer.git" }
    }
  },
  "enabledPlugins": {
    "breadfast-workflow@breadfast": true,
    "humanizer@humanizer": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/doctor.mjs\" --session-start",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
