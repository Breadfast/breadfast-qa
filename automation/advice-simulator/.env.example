# Advice message simulator settings.
# Copy this file to .env (git-ignored) and fill in the values you need.
# Anything exported in your shell wins over this file, and CLI flags win over both.

# ---- Target environment -----------------------------------------------------
# Local app:  http://localhost:1337
# Testing:    https://card-panel-testing.breadfast.tech
# Testing (backend host, bypasses the panel): https://card-backend-testing.breadfast.tech
BASE_URL=http://localhost:1337

# ---- MDP advice-message credentials ----------------------------------------
# Must match mdp.adviceMessage.clientId / clientSecret in the target env's config/local.js
MDP_CLIENT_ID=mdp-client
MDP_CLIENT_SECRET=

# ---- What to simulate -------------------------------------------------------
# MDP card id = Cards.externalId in our DB (what MDP sends as cardId/cardNumber).
# It must exist in the target environment's database.
CARD_ID=100004700036

# Name (PURCHASE, REFUND, CASH_WITHDRAWAL, P2P_CREDIT, ...) or a raw MDP code like 774.
# Full list is in TRANSACTION_TYPES inside simulate-advice-messages.js
TRANSACTION_TYPE=PURCHASE

# How many advice messages to fire, sequentially
REQUEST_COUNT=1

# Amount per request in EGP. Leave empty for a random 1..1000 EGP per request.
AMOUNT_EGP=

# Pause between requests, in milliseconds
DELAY_MS=300

# -1 = approved. Any other MDP response code is sent as a decline.
RESPONSE_CODE=-1

# Acquirer merchant id sent in the payload (trailing spaces are meaningful to MDP)
MERCHANT_ID=MSVIPES
