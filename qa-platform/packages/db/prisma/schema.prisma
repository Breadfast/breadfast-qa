// Breadfast QA Platform — shared backend schema (PostgreSQL).
// Mirrors packages/shared/src/domain.ts. See ARCHITECTURE.md §07 Database Design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev = sqlite (zero-infra). Production shared backend = postgresql:
  // flip this to "postgresql" and point DATABASE_URL at the server.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Identity & access ──────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  googleSub String   @unique
  email     String   @unique
  name      String
  role      String   @default("tester") // tester | lead | admin
  createdAt DateTime @default(now())

  integrations Integration[]
  stories      Story[]        @relation("StoryOwner")
  runs         Run[]
  approvals    Approval[]
  auditEvents  AuditLog[]
}

// Per-user OAuth tokens for Jira / Figma / Slack (encrypted at rest).
model Integration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String // jira | figma | slack
  encTokens   String // encrypted JSON blob
  scopes      String?
  accountId   String?
  connectedAt DateTime @default(now())

  @@unique([userId, provider])
}

// Shared infra credentials (BrowserStack, DB/SSH, app logins) — encrypted.
model SharedSecret {
  key       String   @id
  encValue  String
  rotatedAt DateTime @default(now())
}

// ── Projects & stories ─────────────────────────────────────────────────────
model Project {
  id            String   @id @default(cuid())
  jiraKey       String   @unique // e.g. "B10"
  name          String
  bsProjectId   String?
  defaultsJson  Json?
  createdAt     DateTime @default(now())
  stories       Story[]
}

model Story {
  id            String   @id @default(cuid())
  jiraKey       String   @unique // e.g. "B10-56336"
  title         String
  platform      String // web | android | ios | cross-platform | web-mobile
  locales       String   @default("en-US,ar-EG") // comma-joined; sqlite has no scalar lists
  status        String   @default("draft")
  environment   String   @default("testing") // testing | staging | production
  notes         String? // optional story notes from the tester
  appUrl        String? // web app under test
  adminUrl      String? // optional admin/web portal for mobile stories
  bsAppIds      Json? // { android?: string, ios?: string }
  bsFolderId    String? // per-story BrowserStack folder override
  devices       Json? // { android?: string, ios?: string } override of defaults
  executionType String   @default("full") // full | smoke | regression
  credentials   Json? // { username?, password?, otpMethod?, extra?: [{key,value}] }
  packageNumbers String? // optional existing package numbers (comma-separated)
  testDataFile  String? // optional path to a test-data file
  executionInstructions String? // free-text AI guidance honored across the run (parse_instructions → directives)
  additionalInputs      String? // free-text extra data/credentials that don't fit a predefined field
  enabledNodes  Json? // string[] of lifecycle node names to run (from selected phases); null = run all
  executionModel String? // model id for the execution step (e.g. claude-opus-4-8); null = platform default
  workspacePath String? // D:\BreadfastQA\<JIRA_KEY>
  jiraHlsUrl    String?
  ownerId       String
  owner         User     @relation("StoryOwner", fields: [ownerId], references: [id])
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs      Run[]
  testCases TestCase[]
  artifacts Artifact[]
  defects   Defect[]
}

// ── Workflow runs ──────────────────────────────────────────────────────────
model Run {
  id            String    @id @default(cuid())
  storyId       String
  story         Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  status        String    @default("queued")
  // Why the run is currently 'paused': gate | ask | credential | manual | usage_limit.
  // Reused across all pause flavors instead of a separate RunStatus value per reason
  // (Run Lifecycle Management — see ARCHITECTURE.md once documented).
  pauseReason   String?
  workerId      String?
  engineSession String? // claude --resume session id — Session Continuity (Run Lifecycle
                         // Management): one shared headless conversation per run, so
                         // consecutive nodes build on the same Claude session instead of
                         // each starting fresh. Written after every successful node call
                         // (packages/engine's runWithSession) and cleared by
                         // resetStepsFrom() on a Restart From Step, since that discards
                         // downstream turns the session would otherwise still remember.
                         // The Context Builder guarantee (ARCHITECTURE.md) still holds:
                         // every prompt is rebuilt in full from persisted state regardless
                         // of whether resume succeeds — a missing/invalid session (wrong
                         // machine, expired, restarted run) falls back to a fresh one
                         // transparently rather than failing the step.
  triggeredById String
  triggeredBy   User      @relation(fields: [triggeredById], references: [id])
  totalTokens   Int       @default(0)
  totalCostUsd  Float     @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  // Workflow Registry & Versioning (Phase 1 #3) — stamped at createRun for
  // reproducibility. All nullable so pre-existing runs are unaffected.
  workflowVersion  String?
  promptVersion    String?
  platformVersion  String?
  knowledgeVersion String?
  frameworkVersion String?
  workflowDefJson  Json? // snapshot of the WorkflowDefinition the run executed under

  // Parity Certification (Phase 1 #5) — deterministic run-evaluation snapshot
  // (score + missing dimensions + certification status). Written on completion.
  parityJson Json?

  // Review Confidence (Phase 2 M2) — deterministic evidence-based confidence
  // (score + per-signal breakdown + reductions). Written on completion.
  reviewJson Json?

  // Story Health (Phase 2 M4) — deterministic six-dimension roll-up (overall
  // score + per-dimension breakdown + reductions), derived by reusing parity +
  // review + visual health. No AI. Written on completion.
  storyHealthJson Json?

  // Recommendations (Phase 2 M5) — deterministic + rule-based prioritized
  // recommendations, derived by reusing parity + review + health + visual
  // patterns + defects + traceability. No AI (ADR-001). Written on completion.
  recommendationsJson Json?

  steps            RunStep[]
  llmRequests      LlmRequestLog[]
  statusEvents     RunStatusEvent[]
}

model RunStep {
  id         String    @id @default(cuid())
  runId      String
  run        Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  name       String // matches shared MVP_NODES
  type       String // code | ai | gate | ask
  status     String    @default("pending")
  ordinal    Int
  inputJson  Json?
  outputJson Json?
  logs       String?
  tokens     Int       @default(0)
  costUsd    Float     @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  // Tester feedback from a Regenerate action, threaded into this node's next
  // AI prompt; cleared once the node consumes it on its next successful run.
  feedback   String?
  // Retry Failed Step increments this; a plain re-run via Restart From Step does
  // not (that's a fresh attempt at a different generation, not a retry of a
  // transient failure). Starts at 1 for every step's first execution.
  attempt    Int       @default(1)
  // Structured failure diagnostics (message, isTimeout, durationMs, sanitized
  // stack) captured when status becomes 'failed' or 'interrupted' — the durable
  // record behind the Failure Details UI panel, independent of the free-text logs.
  errorJson  Json?

  approval      Approval?
  clarification Clarification?

  @@unique([runId, ordinal])
}

// History of Run.status transitions — buildActivityTimeline derives everything
// else from RunStep/Approval/Clarification + the run's CURRENT status, which
// can't show "this run was paused twice" without a record of past transitions.
// Written once per transition, in RunsService.ingest()'s existing 'run.status'
// case — no new call sites needed. No AI (ADR-001); pure audit bookkeeping.
model RunStatusEvent {
  id     String   @id @default(cuid())
  runId  String
  run    Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  status String
  reason String?
  at     DateTime @default(now())

  @@index([runId, at])
}

model Approval {
  id         String   @id @default(cuid())
  runStepId  String   @unique
  runStep    RunStep  @relation(fields: [runStepId], references: [id], onDelete: Cascade)
  action     String // jira.push_hls | browserstack.upload_testcases | jira.file_bug
  payload    Json
  decision   String? // approved | rejected
  feedback   String?
  decidedById String?
  decidedBy  User?    @relation(fields: [decidedById], references: [id])
  decidedAt  DateTime?
  createdAt  DateTime @default(now())
}

model Clarification {
  id           String   @id @default(cuid())
  runStepId    String   @unique
  runStep      RunStep  @relation(fields: [runStepId], references: [id], onDelete: Cascade)
  questionsJson Json
  answersJson  Json?
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime @default(now())
}

// ── Artifacts, test cases, defects ─────────────────────────────────────────
model TestCase {
  id         String   @id @default(cuid())
  storyId    String
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  externalId String? // BrowserStack TM id once uploaded
  title      String
  stepsJson  Json
  priority   String   @default("P2")
  status     String   @default("draft")
  createdAt  DateTime @default(now())
}

model Artifact {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  runId     String?
  kind      String // report | screenshot | video | csv | trace | evidence | figma_frame
  // Logical name the versions share (e.g. "report", "testcases.csv") so all
  // versions of "the same" artifact can be listed/ordered together. version 1
  // is the first write; a Restart From Step that would otherwise overwrite the
  // same path instead writes version N+1 to a suffixed path, keeping the old
  // file + row intact (Run Lifecycle Management — nothing generated is lost).
  name      String   @default("")
  version   Int      @default(1)
  localPath String?
  objectUrl String?
  mime      String?
  bytes     Int?
  createdAt DateTime @default(now())
}

model Defect {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  jiraKey   String?
  title     String
  severity  String // Blocker | Critical | Major | Minor | Trivial
  priority  String // P0..P3
  status    String   @default("open")
  createdAt DateTime @default(now())
}

// ── Knowledge center ───────────────────────────────────────────────────────
model KnowledgeDoc {
  path        String   @id // e.g. docs/ai/business/business-rules.md
  title       String
  type        String // process | reference | business | module | framework
  contentHash String
  updatedById String?
  updatedAt   DateTime @updatedAt

  proposals KnowledgeProposal[]
}

model KnowledgeProposal {
  id            String       @id @default(cuid())
  docPath       String
  doc           KnowledgeDoc @relation(fields: [docPath], references: [path], onDelete: Cascade)
  diffJson      Json
  rationale     String
  status        String       @default("pending") // pending | approved | rejected
  proposedByRun String?
  reviewerId    String?
  createdAt     DateTime     @default(now())
}

// ── Reusable configuration (Settings) ──────────────────────────────────────
// Rarely-changing config moved out of the story wizard: Jira/BrowserStack/
// Figma/AI/Automation/Integrations. Secrets are flagged + masked in the UI.
model Setting {
  key       String   @id // e.g. "browserstack.accessKey"
  group     String // jira | browserstack | figma | ai | automation | integrations
  value     String // string or JSON-encoded value
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ── Test data pool ──────────────────────────────────────────────────────────
// Phone numbers, packages, accounts, cards, OTP accounts. Allocated to runs
// automatically; lifecycle available → reserved → consumed.
model TestDataItem {
  id              String   @id @default(cuid())
  type            String // phone | package | account | card | otp
  label           String
  value           Json // arbitrary fields per type
  status          String   @default("available") // available | reserved | consumed
  reservedByRunId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type, status])
}

// ── Framework Registry (Phase D) ─────────────────────────────────────────────
// Per-user registry of automation frameworks (Playwright/Appium/…). Paths are
// machine-specific → never committed. Consumed by the worker to locate the
// Playwright/Java frameworks instead of any hardcoded folder name.
model Framework {
  id                       String    @id @default(cuid())
  name                     String
  platform                 String // web | android | ios | mobile | api | cross-platform
  type                     String // playwright | appium | java-appium | api | other
  localPath                String
  description              String?
  validationStatus         String    @default("unscanned") // valid | invalid | not-found | unscanned
  scanDetails              String?
  lastScan                 DateTime?
  version                  String?
  gitCommit                String?
  gitBranch                String?
  lastSuccessfulGeneration DateTime?
  lastGenerationStory      String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

// ── LLM Request Log (Phase 1 #7) ─────────────────────────────────────────────
// One row per AI call, captured at the worker's ai() seam and persisted via the
// API. The durable record behind Story Replay + AI Explainability, and the
// source of exact per-call token/cost. Prompts are redacted of secrets before
// storage (local-first: values live only in the local DB).
model LlmRequestLog {
  id              String   @id @default(cuid())
  runId           String?
  run             Run?     @relation(fields: [runId], references: [id], onDelete: Cascade)
  runStepId       String?
  node            String // lifecycle node name
  schemaName      String?
  model           String?
  promptVersion   String?
  workflowVersion String?
  systemPrompt    String? // redacted
  userPrompt      String? // redacted
  rawResponse     String?
  validatedOutput Json?
  status          String // ok | repaired | parse_failed | schema_failed | error
  repaired        Boolean  @default(false)
  repairStage     String?
  tokens          Int      @default(0)
  costUsd         Float    @default(0)
  durationMs      Int      @default(0)
  attempt         Int      @default(1)
  createdAt       DateTime @default(now())

  @@index([runId, createdAt])
}

// ── Audit ──────────────────────────────────────────────────────────────────
model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id])
  action   String
  entity   String
  entityId String?
  diffJson Json?
  at       DateTime @default(now())
}
