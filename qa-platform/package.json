{
  "name": "breadfast-qa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Breadfast QA Platform — enterprise orchestration shell around the Claude-driven QA Companion.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "engine:smoke": "node packages/engine/smoke.mjs",
    "db:generate": "npm run generate -w @qa/db",
    "db:push": "npm run push -w @qa/db",
    "dev:api": "npm run dev -w @qa/api",
    "dev:worker": "npm run dev -w @qa/worker",
    "dev:web": "npm run dev -w @qa/web",
    "dev": "concurrently -n api,worker,web -c cyan,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
