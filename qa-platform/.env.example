# ─────────────────────────────────────────────────────────────────────────
# Breadfast QA Platform — environment template. Copy to .env and fill in.
# LOCAL-FIRST: each tester runs the full stack locally. Prefer configuring
# credentials in Settings (encrypted at rest); the vars below are optional
# overrides. NEVER put real secrets in a committed file. No absolute D:\ paths.
# ─────────────────────────────────────────────────────────────────────────

# ── Paths (both optional; auto-resolved when unset) ──────────────────────
# Repo root = engine cwd (CLAUDE.md + docs/ai/** auto-load from here).
# Auto-detected by walking up to the dir containing CLAUDE.md; override only if needed.
# QA_COMPANION_DIR=""
# Per-user runtime workspace (SQLite DB, artifacts, logs, sessions) — OUTSIDE the repo.
# Defaults to ~/BreadfastQA/Workspace (macOS/Linux) or %USERPROFILE%\BreadfastQA\Workspace (Windows).
# QA_WORKSPACE_DIR=""

# ── Database (local-first: SQLite in the workspace) ──────────────────────
# Auto-derived as file:<workspace>/qa.db when unset. Override for a custom location.
# DATABASE_URL="file:./qa.db"

# ── External-write guards (SAFE DEFAULTS: dry-run ON) ────────────────────
# Keep these true until parity is verified. Flip to false to perform live writes.
QA_DRY_RUN="true"
JIRA_BUG_DRY_RUN="true"

# ── Engine: local Claude CLI (per-user subscription) ──────────────────────
CLAUDE_BIN="claude"
ENGINE_MODEL="claude-opus-4-8"
ENGINE_MODEL_CHEAP="claude-haiku-4-5-20251001"
ENGINE_MODEL_EXECUTION="claude-sonnet-5"
ENGINE_EFFORT_EXECUTION="high"

# ── Auth: Google SSO (optional in local dev — a dev header bypass exists) ─
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"
ALLOWED_EMAIL_DOMAIN="breadfast.com"
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Secrets encryption (AES-256-GCM for stored secrets) ──────────────────
# 32-byte base64 key. Generated at onboarding if left blank.
SECRETS_ENCRYPTION_KEY=""

# ── Integrations (PREFER Settings UI; these are optional env overrides) ──
# BrowserStack (Test Management + execution). Configure in Settings; do not commit real values.
# BS_TM_USERNAME=""
# BS_TM_API_TOKEN=""
# BS_TM_UI_USERNAME=""
# BS_TM_UI_PASSWORD=""
# BS_TM_PROJECT=""
# BS_TM_DEFAULT_FOLDER=""
# Jira (read stories / push HLS / file defects).
# JIRA_BASE_URL="https://breadfast.atlassian.net"
# JIRA_EMAIL=""
# JIRA_API_TOKEN=""
# Figma REST fallback token (browser session is the primary path).
# FIGMA_TOKEN=""

# ── Framework paths (PREFER the Framework Registry; optional overrides) ──
# BF_B55168_DIR=""        # Playwright web framework clone
# BF_JAVA_FRAMEWORK_DIR=""# Java/Appium framework clone

# ── Wiring ────────────────────────────────────────────────────────────────
API_PORT="4000"
WEB_PORT="3000"
API_BASE_URL="http://localhost:4000"
WORKER_ID="local-dev"

# ── Object storage (OPTIONAL — local-first keeps artifacts on disk) ──────
# S3_ENDPOINT=""
# S3_REGION="us-east-1"
# S3_BUCKET="qa-artifacts"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
